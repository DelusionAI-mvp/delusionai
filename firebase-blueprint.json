{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and emotional state",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "onboarded": { "type": "boolean" },
        "emotionalProfile": {
          "type": "object",
          "properties": {
            "moodBaseline": { "type": "number" },
            "emotionalTags": { "type": "array" },
            "communicationStyle": { "type": "string" },
            "emotionalOpenness": { "type": "number" },
            "supportPreference": { "type": "string" },
            "emotionalEnergy": { "type": "number" },
            "intentType": { "type": "string" },
            "socialCompatibility": { "type": "number" }
          }
        },
        "isPremium": { "type": "boolean" },
        "matchRequestCount": { "type": "number" },
        "lastMatchRequestAt": { "type": "string", "format": "date-time" },
        "currentSituation": { "type": "string" },
        "whyJoined": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "UserNotification": {
      "title": "UserNotification",
      "description": "In-app notifications for connection and peer requests",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "text": { "type": "string" },
        "type": { "type": "string", "enum": ["accept", "reject", "message", "request", "system"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "read": { "type": "boolean" },
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "connectionId": { "type": "string" }
      }
    },
    "Waitlist": {
      "title": "Waitlist",
      "description": "Pre-launch registration",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "submittedAt": { "type": "string", "format": "date-time" }
      }
    },
    "Connection": {
      "title": "Connection",
      "description": "Peer-to-peer connection request and status",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "users": { "type": "array" },
        "status": { "type": "string", "enum": ["pending", "accepted", "rejected"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "initiatorId": { "type": "string" },
        "receiverId": { "type": "string" }
      }
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Messages within a peer chat (text only)",
      "type": "object",
      "properties": {
        "text": { "type": "string" },
        "senderId": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    },
    "MayaConversation": {
      "title": "MayaConversation",
      "description": "Interaction history with Maya AI",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "messages": { "type": "array" },
        "lastUpdated": { "type": "string", "format": "date-time" }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Main user collection"
    },
    "/users/{userId}/notifications/{notifId}": {
      "schema": "UserNotification",
      "description": "Individual notifications for connection updates"
    },
    "/connections/{connectionId}": {
      "schema": "Connection",
      "description": "Peer connections"
    },
    "/connections/{connectionId}/messages/{messageId}": {
      "schema": "ChatMessage",
      "description": "Messages for a connection"
    },
    "/conversations_maya/{userId}": {
      "schema": "MayaConversation",
      "description": "Maya AI chat history"
    },
    "/waitlist/{id}": {
      "schema": "Waitlist",
      "description": "Pre-launch registrations"
    }
  }
}
